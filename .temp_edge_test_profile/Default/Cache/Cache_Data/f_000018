  <!-- Mobile Restriction Interaction Handler (Past Mobile Screen) -->
  <script>
    (function() {
      const mobileWarning = document.getElementById('mobile-warning');
      const restrictedCard = document.getElementById('mobile-restricted-card');
      const restrictedSub = document.getElementById('mobile-restricted-sub');
      const pulseRing = document.getElementById('mobile-pulse-ring');
      const flashOverlay = document.getElementById('mobile-flash-overlay');

      if (!mobileWarning || !restrictedCard || !restrictedSub) return;

      let timer = null;
      let lastTapTime = 0;

      // Synthetic Classified Audio Denial Tone (Zero external dependencies)
      function playDenialBeep() {
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          if (!window.__mobAudioCtx) {
            window.__mobAudioCtx = new AudioContextClass();
          }
          const ctx = window.__mobAudioCtx;
          if (ctx.state === 'suspended') {
            ctx.resume();
          }
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sawtooth';
          osc.frequency.setValueAtTime(110, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.14);

          gain.gain.setValueAtTime(0.18, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.14);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.15);
        } catch (e) {
          // Audio fails gracefully if browser restricts
        }
      }

      function triggerMobileDenial(e) {
        const now = Date.now();
        if (now - lastTapTime < 250) return; // Prevent double trigger from touch+click
        lastTapTime = now;

        // 1. Trigger Card Shake Animation
        restrictedCard.classList.remove('denied-shake');
        void restrictedCard.offsetWidth; // force DOM reflow
        restrictedCard.classList.add('denied-shake');

        // 2. Trigger Expanding Shockwave Pulse Ring Effect
        if (pulseRing) {
          pulseRing.classList.remove('pulse-active');
          void pulseRing.offsetWidth;
          pulseRing.classList.add('pulse-active');
        }

        // 3. Trigger Screen Perimeter Flash Effect
        if (flashOverlay) {
          flashOverlay.classList.remove('flash-active');
          void flashOverlay.offsetWidth;
          flashOverlay.classList.add('flash-active');
        }

        // 4. Update Subtext Feedback
        restrictedSub.textContent = '[ AUTH FAILED // DESKTOP TERMINAL REQUIRED ]';
        restrictedSub.style.color = '#ff3366';

        // 5. Tactile Haptic Vibration for Mobile Devices
        try {
          if (navigator.vibrate) {
            navigator.vibrate([45, 30, 45]);
          }
        } catch (err) {}

        // 6. Play Micro Denial Sound Effect
        playDenialBeep();

        // 7. Reset Subtext after delay
        clearTimeout(timer);
        timer = setTimeout(function() {
          restrictedSub.innerHTML = 'CLICK ANYWHERE &middot; AUTHENTICATE';
          restrictedSub.style.color = '#ff7597';
        }, 2200);
      }

      // Support pointerdown, touchstart, and click for instant response across all devices
      mobileWarning.addEventListener('pointerdown', triggerMobileDenial, { passive: true });
      mobileWarning.addEventListener('click', triggerMobileDenial);
    })();
  </script>
